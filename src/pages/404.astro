---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>404 · JASON Y</title>
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <canvas id="ascii" aria-hidden="true"></canvas>
    <div class="shade"></div>
    <div class="grain"></div>
    <main class="nf">
      <img src="/logo.svg" alt="Jason Y" draggable="false" />
      <p class="code">404 // PAGE NOT FOUND</p>
      <a href="/">[ BACK HOME ]</a>
    </main>
    <script>
      import '../scripts/ascii.js';
    </script>
    <Analytics />
  </body>
</html>

<style is:global>
  .nf {
    position: fixed; inset: 0; z-index: 1;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px;
    text-align: center; padding: var(--pad);
  }
  .nf img { width: min(52vw, 260px); aspect-ratio: 983 / 749; filter: drop-shadow(0 0 18px rgba(255,255,255,.25)); user-select: none; -webkit-user-drag: none; }
  .nf .code { font-size: 12px; letter-spacing: .2em; color: var(--fg); background: #000; padding: 4px 10px; }
  .nf a { color: var(--fg); background: #000; font-size: 13px; letter-spacing: .18em; text-decoration: none; padding: 8px 12px; transition: color .15s; }
  .nf a:hover, .nf a:focus-visible { color: #fff; text-decoration: underline; outline: none; }
</style>
