---
import '../styles/global.css';
import { siInstagram, siTiktok, siYoutube, siSpotify, siApplemusic } from 'simple-icons';
import { links, socials, settings } from '../data/links';

const icons = {
  instagram: siInstagram.path,
  tiktok: siTiktok.path,
  youtube: siYoutube.path,
  spotify: siSpotify.path,
  applemusic: siApplemusic.path,
} as Record<string, string>;
const visible =links.filter((l) => l.active !== false);
const pad = (n: number) => String(n).padStart(2, '0');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{settings.name}</title>
    <meta name="description" content={`${settings.name}. ${settings.tagline}. Stream, watch and follow.`} />
    <meta name="theme-color" content="#000000" />
    <meta property="og:title" content={`${settings.name}`} />
    <meta property="og:image" content={settings.avatar} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body class="links-page">
    {settings.background === 'ascii' && <canvas id="ascii" aria-hidden="true"></canvas>}
    <div class="shade"></div>
    <div class="grain"></div>

    <main
      data-layout={settings.layout}
      data-button={settings.buttonStyle}
      style={`--accent:${settings.accent};--maxw:${settings.maxWidth}px`}
    >
      <header>
        <h1>
          <img class="wordmark" src="/logo.svg" alt={`${settings.name} — ${settings.tagline}`} draggable="false" />
        </h1>
        <nav class="socials" aria-label="Social links">
          {socials.map((s) => (
            <a href={s.url} {...(s.url.startsWith('mailto:') ? {} : { target: '_blank', rel: 'noopener' })} aria-label={s.label} title={s.label}>
              {s.icon === 'email' ? (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2.5" y="4.5" width="19" height="15" rx="2" />
                  <path d="m3 6.5 9 7 9-7" />
                </svg>
              ) : s.icon === 'website' ? (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="9.5" />
                  <ellipse cx="12" cy="12" rx="4.2" ry="9.5" />
                  <path d="M2.5 12h19" />
                </svg>
              ) : (
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={icons[s.icon]} /></svg>
              )}
            </a>
          ))}
        </nav>
      </header>

      <ul class="list">
        {visible.map((l, i) => (
          <>
            {l.group && <li class="group">// {l.group}</li>}
            <li class:list={['item', l.featured && 'featured']}>
              <a href={l.url} target="_blank" rel="noopener">
                {settings.showThumbnails && l.thumb && (
                  <img class="thumb" src={`/links/${l.thumb}`} alt="" loading={i < 3 ? 'eager' : 'lazy'} />
                )}
                <span class="text">
                  {l.tag && <span class="tag">{l.tag}</span>}
                  <span class="title">{l.title}</span>
                </span>
                {settings.showNumbers && <span class="num">{pad(i + 1)}</span>}
                <span class="arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          </>
        ))}
      </ul>

      <footer>
        <span>© <span id="year">{new Date().getFullYear()}</span> {settings.name}</span>
      </footer>
      <script is:inline>
        document.getElementById('year').textContent = new Date().getFullYear();
      </script>
    </main>

    {settings.background === 'ascii' && (
      <script>
        import '../scripts/ascii.js';
      </script>
    )}
  </body>
</html>

<style is:global>
  html:has(.links-page), .links-page { height: auto; min-height: 100%; overflow-x: hidden; overflow-y: auto; }
  .links-page .shade { background: radial-gradient(ellipse at 50% 40%, rgba(0,0,0,.72) 0%, rgba(0,0,0,.55) 60%, rgba(0,0,0,.85) 100%); }

  .links-page main {
    position: relative; z-index: 1;
    --gutter: clamp(24px, 7vw, 40px);
    width: min(var(--maxw, 520px), 100% - 2 * var(--gutter));
    margin: 0 auto;
    padding: clamp(32px, 8vh, 72px) 0 40px;
    display: flex; flex-direction: column; gap: 28px;
  }
  .links-page header { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 10px; }
  .links-page h1 { line-height: 0; }
  .wordmark { display: block; width: min(250px, 78vw); aspect-ratio: 983 / 749; margin: -18px 0; filter: drop-shadow(0 0 14px rgba(255,255,255,.2)); user-select: none; -webkit-user-drag: none; }

  .socials { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 18px; margin-top: 6px; }
  .socials a { display: grid; place-items: center; width: 36px; height: 36px; color: var(--fg); opacity: .75; transition: opacity .15s, color .15s, transform .15s; }
  .socials svg { width: 22px; height: 22px; }
  .socials a:hover, .socials a:focus-visible { opacity: 1; color: var(--accent); transform: translateY(-2px); outline: none; }

  .list { list-style: none; display: grid; gap: 10px; }
  main[data-layout="grid"] .list { grid-template-columns: repeat(2, 1fr); }
  main[data-layout="grid"] .item.featured { grid-column: 1 / -1; }
  .group { color: var(--dim); font-size: 11px; letter-spacing: .16em; margin-top: 10px; grid-column: 1 / -1; }

  .item a {
    position: relative; display: flex; align-items: center; gap: 14px;
    padding: 10px 14px 10px 10px; min-height: 64px;
    color: var(--fg); text-decoration: none;
    background: rgba(0,0,0,.72); border: 1px solid rgba(244,244,240,.55);
    backdrop-filter: blur(3px);
    transition: transform .15s, border-color .15s, background .15s, color .15s;
  }
  main[data-button="fill"] .item a { background: var(--fg); color: #000; border-color: var(--fg); }
  main[data-button="fill"] .item a .num, main[data-button="fill"] .item a .tag { color: #555; }
  .item a:hover, .item a:focus-visible {
    transform: translate(-2px, -2px); border-color: var(--accent);
    box-shadow: 3px 3px 0 var(--accent); outline: none;
  }
  .thumb { width: 48px; height: 48px; object-fit: cover; flex: none; border: 1px solid rgba(244,244,240,.35); }
  .text { display: flex; flex-direction: column; gap: 3px; min-width: 0; flex: 1; }
  .title { font-size: 14px; line-height: 1.3; overflow-wrap: anywhere; }
  .tag { font-size: 10px; letter-spacing: .18em; color: var(--accent); opacity: .9; }
  .num { font-size: 11px; color: var(--dim); letter-spacing: .08em; }
  .arrow { font-size: 14px; opacity: .6; transition: transform .15s, opacity .15s; }
  .item a:hover .arrow { transform: translate(2px, -2px); opacity: 1; }

  .item.featured a { flex-direction: column; align-items: stretch; padding: 10px; gap: 10px; }
  .item.featured .thumb { width: 100%; height: auto; aspect-ratio: 1 / 1; }
  .item.featured .text { padding: 0 4px 2px; }
  .item.featured .title { font-size: 16px; }
  .item.featured .num, .item.featured .arrow { position: absolute; top: 18px; right: 18px; background: #000; color: var(--fg); padding: 2px 6px; }
  .item.featured .arrow { top: auto; bottom: 14px; right: 16px; background: none; }

  main[data-layout="grid"] .item:not(.featured) a { flex-direction: column; align-items: flex-start; padding: 10px; }
  main[data-layout="grid"] .item:not(.featured) .thumb { width: 100%; height: auto; aspect-ratio: 1 / 1; }
  main[data-layout="grid"] .item:not(.featured) .num, main[data-layout="grid"] .item:not(.featured) .arrow { display: none; }

  .links-page footer { text-align: center; color: var(--dim); font-size: 10px; letter-spacing: .14em; margin-top: 12px; }

  @media (max-width: 420px) {
    main[data-layout="grid"] .list { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .item a, .item a:hover { transition: none; transform: none; }
  }
</style>
